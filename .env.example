# Copy to .env — docker compose reads it automatically.

# Required. Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Docker Compose database settings. Keep the password secret and URL-safe;
# `openssl rand -hex 32` is a convenient choice.
POSTGRES_USER=pgpkeygen
POSTGRES_PASSWORD=
POSTGRES_DB=pgpkeygen

# Optional. Trust X-Forwarded-For only when a sanitizing reverse proxy is the
# sole ingress path to the app. Directly exposed app ports must leave this false.
TRUST_PROXY_HEADERS=false

# Optional. Maximum number of stored PGP keys per user. Defaults to 50.
MAX_KEYS_PER_USER=50

# Optional. Time zone for times shown in the app, as an IANA name. Defaults to
# Asia/Jakarta (UTC+7). Timestamps are always stored in UTC.
APP_TIME_ZONE=Asia/Jakarta
